# Конфигурация Firebase (вход через Google + синхронизация через Firestore).
#
# 1. Создайте проект на https://console.firebase.google.com
# 2. Project settings → General → «Your apps» → добавьте Web-приложение (</>)
#    и скопируйте значения из объекта firebaseConfig сюда.
# 3. Authentication → Sign-in method → включите провайдер Google.
# 4. Firestore Database → создайте базу (Production mode) и задайте правила
#    (см. README, раздел «Синхронизация»).
#
# Скопируйте этот файл в `.env` и подставьте свои значения:
#   cp .env.example .env
#
# Эти ключи НЕ секретны — они публичны в любом веб-приложении Firebase.
# Доступ к данным защищают правила Firestore, а не сокрытие ключей.

# Примечание: рабочий публичный конфиг уже зашит в src/lib/firebaseConfig.ts,
# поэтому .env нужен только если хотите подключить ДРУГОЙ проект Firebase
# (например, отдельный для разработки) — эти переменные перекроют значения
# по умолчанию.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Секретарь (scripts/secretary.mjs) ---
#
# Чьи данные правит скрипт из командной строки. Обычно это тот же аккаунт
# Google, которым выполнен вход в приложении. Узнать доступные:
#   node scripts/secretary.mjs who
SECRETARY_EMAIL=
# Либо напрямую uid, тогда SECRETARY_EMAIL не нужен:
# SECRETARY_UID=
#
# Ключ service account (Admin SDK). В отличие от VITE_FIREBASE_* выше — это
# НАСТОЯЩИЙ секрет: он даёт полный доступ к базе в обход правил Firestore.
# По умолчанию берётся ./service-account.json (файл в .gitignore).
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
